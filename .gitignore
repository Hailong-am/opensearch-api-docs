node_modules/
package-lock.json

# Local AWS probe / test scripts — never commit (may contain real resource IDs,
# endpoints, or account numbers). Keep these outside the repo or under these names.
*-probe.sh
*probe*.sh
scratch/
.local-test/

# Intermediate build artifacts (regenerated by tools/build-distribution-specs.sh).
# The *-tagged.json files ARE tracked because the deployed site loads them.
build/*.yaml
build/opensearch-openapi-oss.json
build/opensearch-openapi-aos.json
build/opensearch-openapi-aos-warm.json
build/opensearch-openapi-aos-full.json
build/opensearch-openapi-aoss.json
build/opensearch-openapi-aoss-full.json
build/opensearch-openapi-aoss-snap.yaml
